# ── MT5 AlphaGPT: 训练产物（体积大、可本地再生）────────────────────
# checkpoints*/ 同时覆盖 checkpoints/ 与 checkpoints_bak_<日期>_<说明>/
# 检查点本身 18~20MB/个、共 166 个（7.5GB），不进 git；
# 每个检查点的版本记录由 checkpoints/INDEX.tsv 承担（含 sha256）。
checkpoints*/
*.pt
*.pth
training_history*.json
best_mt5_strategy.json
_backup_ckpt_*/
_install_temp_backup_*/
# 被中断的 filter-branch 残留，无 .git 时无意义
.git-rewrite/

# ── 策略输出（公式版本，只有几百字节，必须纳入版本控制）───────────
strategies/*.json
strategies/*.txt
# 每个品种最新公式 = 当前模型版本，跟着代码一起提交
!strategies/best_*.json
!strategies/README.md
!strategies/*.md

# ── 回测/验证输出（图表、报告、可再生产物）────────────────────────
backtest_output/
backtest_output_*/
verification_results.json

# ── 实盘/运行态文件 ────────────────────────────────────────────────
portfolio_state.json
web_settings.json
ai_analysis_history.json
train_elapsed.json
training_time_*.json
STOP_SIGNAL
train.pid
train_stdout.log
train_stderr.log
*.log
logs/

# ── 本地数据缓存（体积大，机器相关）──────────────────────────────
data/
!data_pipeline/
data/cache/
**/kline_cache/
*.parquet
*.hcc
*.hc

# ── 临时脚本/分析输出 ──────────────────────────────────────────────
_tmp_*.py
backtest_current_forex.py
_quick_bt.py

# ── 本机配置 / 密钥 / 临时下载（绝不上传）──────────────────────────
tmp_downloads/
tmp/
*.zip
web_settings*.json
!web_settings.example.json
.ai_*/
secrets/
*.pem
*.key
credentials*.json
local_settings*.json
ark_rotation_state.json

# ── 控制台（cockpit）──────────────────────────────────────────────
# 打包产物：体积大且可重建（python build_exe.py）
build/
dist/
*.spec
AlphaMaster.exe

# 首次运行自动生成的路径配置（含本机绝对路径）
cockpit.json

# 运行时日志与浏览器配置目录
logs/
